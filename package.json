{
  "name": "visual-ai-coding",
  "private": true,
  "version": "0.18.0",
  "description": "可视化管理 Claude Code 与 Codex 配置、插件和工具的 Electron 桌面应用",
  "productName": "Visual AI Coding",
  "author": "imber",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imberZsk/visual-ai-coding.git"
  },
  "homepage": "https://imber-visual-docs.netlify.app/visual-ai-coding",
  "bugs": {
    "url": "https://github.com/imberZsk/visual-ai-coding/issues"
  },
  "keywords": [
    "electron",
    "claude-code",
    "codex",
    "plugins",
    "react",
    "vite",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "node scripts/dev-or-reuse.mjs --host 127.0.0.1 --port 5274 --strictPort",
    "dev:electron": "wait-on tcp:5274 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n vite,electron \"node scripts/dev-or-reuse.mjs --host 127.0.0.1 --port 5274 --strictPort\" \"wait-on tcp:5274 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc && vite build",
    "build:ui": "tsc && vite build",
    "start": "pnpm run build:ui && cross-env NODE_ENV=production electron .",
    "preview": "vite preview",
    "verify:boot": "pnpm run build:ui && node scripts/verify-boot.mjs",
    "dist": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm run build:ui && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64 --publish never",
    "test": "vitest run",
    "test:e2e": "pnpm run build:ui && playwright test",
    "test:e2e:headed": "pnpm run build:ui && playwright test --headed",
    "test:e2e:ui": "pnpm run build:ui && playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.3",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.imber.visual-aicoding",
    "productName": "Visual AI Coding",
    "publish": [
      {
        "provider": "github",
        "owner": "imberZsk",
        "repo": "visual-ai-coding"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "VisualAICoding-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "dmg": {
      "title": "Visual AI Coding ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VisualAICoding-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "VisualAICoding-${version}-portable.${ext}"
    }
  }
}
